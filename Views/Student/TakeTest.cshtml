@model TakeTestViewModel

@{
    ViewData["Title"] = "Sınav";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sınav Oluşturma Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/app.css" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#4F46E5',
                        accent: '#10B981',
                        danger: '#EF4444',
                        ink: '#0F172A',
                        'ink-500': '#64748B',
                        'ink-300': '#94A3B8',
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                }
            }
        }
    </script>
</head>
<body class="bg-[var(--bg)] min-h-screen font-sans">
    <div class="max-w-4xl mx-auto px-4 py-8">
        <!-- Progress Bar -->
        <div class="fixed top-0 left-0 w-full h-1 bg-[var(--border)] z-50">
            <div id="progressBar" class="h-1 bg-primary transition-all duration-1000" style="width: 0%"></div>
        </div>

        <!-- Timer Header -->
        <div class="card p-6 mb-6 sticky top-4 z-10">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex-1">
                    <h1 class="text-2xl font-bold text-ink">@Model.TestTitle</h1>
                    @if (!string.IsNullOrEmpty(Model.TestDescription))
                    {
                        <p class="text-ink-500 mt-1">@Model.TestDescription</p>
                    }
                    <div class="flex items-center gap-3 mt-3">
                        <span class="badge badge-primary">@Model.Questions.Count soru</span>
                        <span id="answeredCount" class="badge badge-accent">0 cevaplandı</span>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm text-ink-500 mb-1">Kalan Süre</p>
                    <p id="timer" class="text-4xl font-bold text-primary">@Model.DurationInMinutes:00</p>
                    <p id="timerWarning" class="text-xs text-[var(--danger)] mt-1 hidden">⚠️ Süre az!</p>
                </div>
            </div>
        </div>

        <form method="post" asp-action="SubmitTest" id="testForm">
            <input type="hidden" asp-for="TestId" />
            <input type="hidden" asp-for="TestTitle" />
            <input type="hidden" asp-for="TestDescription" />
            <input type="hidden" asp-for="DurationInMinutes" />

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <div class="card p-6 mb-6 question-card" data-question-index="@i">
                    <div class="flex items-start gap-4 mb-4">
                        <div class="h-10 w-10 rounded-full bg-primary-light text-primary flex items-center justify-center font-bold text-sm shrink-0">
                            @(i + 1)
                        </div>
                        <div class="flex-1">
                            <p class="font-semibold text-ink text-lg mb-2">@Model.Questions[i].QuestionText</p>
                            <span class="badge badge-warning">@Model.Questions[i].Points puan</span>
                        </div>
                    </div>

                    <input type="hidden" asp-for="Questions[i].QuestionId" />
                    <input type="hidden" asp-for="Questions[i].QuestionText" />
                    <input type="hidden" asp-for="Questions[i].Points" />

                    <div class="space-y-3 ml-14">
                        @for (int j = 0; j < Model.Questions[i].Options.Count; j++)
                        {
                            var optionLabels = new[] { "A", "B", "C", "D" };
                            <label for="q@(i)_opt@(j)" class="flex items-center p-4 border-2 border-[var(--border)] rounded-lg hover:border-primary hover:bg-[var(--bg)] cursor-pointer transition-all">
                                <div class="h-8 w-8 rounded bg-[var(--bg)] text-ink-500 font-bold text-sm flex items-center justify-center mr-3 shrink-0">
                                    @optionLabels[j]
                                </div>
                                <input class="h-5 w-5 text-primary focus:ring-primary border-[var(--border)] mr-3" type="radio"
                                       name="Questions[@i].SelectedOption"
                                       value="@j"
                                       id="q@(i)_opt@(j)"
                                       onchange="updateAnsweredCount()" />
                                <span class="text-ink flex-1">@Model.Questions[i].Options[j].OptionText</span>
                                <input type="hidden" asp-for="Questions[i].Options[j].OptionId" />
                                <input type="hidden" asp-for="Questions[i].Options[j].OptionText" />
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="card p-6 mt-8">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
                    <div>
                        <h3 class="font-semibold text-ink">Sınavı Tamamla</h3>
                        <p class="text-sm text-ink-500 mt-1">Tüm soruları cevapladığınızdan emin olun</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-ink-500">Tamamlanma</p>
                        <p id="completionPercentage" class="text-2xl font-bold text-primary">0%</p>
                    </div>
                </div>
                <div class="progress-track mb-6">
                    <div id="completionBar" class="progress-fill" style="width: 0%"></div>
                </div>
                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary flex-1 py-3">Sınavı Gönder</button>
                    <a asp-action="Dashboard" class="btn btn-ghost flex-1 py-3">İptal</a>
                </div>
            </div>
        </form>
    </div>

    <script>
        let timeLeft = @Model.DurationInMinutes * 60;
        const totalTime = timeLeft;
        const timerElement = document.getElementById('timer');
        const timerWarning = document.getElementById('timerWarning');
        const progressBar = document.getElementById('progressBar');
        const form = document.getElementById('testForm');
        const totalQuestions = @Model.Questions.Count;

        function updateTimer() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timerElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;

            const timeProgress = ((totalTime - timeLeft) / totalTime) * 100;
            progressBar.style.width = timeProgress + '%';

            if (timeLeft <= 60 && timeLeft > 0) {
                timerWarning.classList.remove('hidden');
                timerElement.classList.add('text-[var(--danger)]');
            }

            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                timerElement.textContent = '0:00';
                alert('Süre doldu! Sınav otomatik olarak gönderiliyor...');
                form.submit();
            }

            timeLeft--;
        }

        function updateAnsweredCount() {
            let answered = 0;
            for (let i = 0; i < totalQuestions; i++) {
                const radios = document.querySelectorAll(`input[name="Questions[${i}].SelectedOption"]`);
                for (let radio of radios) {
                    if (radio.checked) {
                        answered++;
                        break;
                    }
                }
            }

            document.getElementById('answeredCount').textContent = `${answered} cevaplandı`;

            const percentage = (answered / totalQuestions) * 100;
            document.getElementById('completionPercentage').textContent = Math.round(percentage) + '%';
            document.getElementById('completionBar').style.width = percentage + '%';

            const cards = document.querySelectorAll('.question-card');
            cards.forEach((card) => {
                const radios = card.querySelectorAll('input[type="radio"]');
                const isAnswered = Array.from(radios).some(r => r.checked);
                if (isAnswered) {
                    card.classList.add('opacity-75');
                } else {
                    card.classList.remove('opacity-75');
                }
            });
        }

        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer();
        updateAnsweredCount();

        window.addEventListener('beforeunload', function (e) {
            e.preventDefault();
            e.returnValue = '';
        });

        form.addEventListener('submit', function() {
            window.removeEventListener('beforeunload', arguments.callee);
        });
    </script>

    <style>
        .option-card:has(input:checked) {
            border-color: #4F46E5;
            background: var(--bg);
        }
    </style>
</body>
</html>
