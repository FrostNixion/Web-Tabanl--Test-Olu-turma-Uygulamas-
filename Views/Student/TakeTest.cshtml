@model TakeTestViewModel

@{
    ViewData["Title"] = "Sınav";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sınav Oluşturma Sistemi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e3a8a',
                        secondary: '#3b82f6',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-100 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 py-8">
        <!-- Timer Header -->
        <div class="bg-white rounded-xl shadow-sm p-6 mb-6 sticky top-4 z-10">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">@Model.TestTitle</h1>
                    @if (!string.IsNullOrEmpty(Model.TestDescription))
                    {
                        <p class="text-slate-600 mt-1">@Model.TestDescription</p>
                    }
                </div>
                <div class="text-right">
                    <div class="text-sm text-slate-600 mb-1">Kalan Süre</div>
                    <div id="timer" class="text-4xl font-bold text-primary">@Model.DurationInMinutes:00</div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="SubmitTest" id="testForm">
            <input type="hidden" asp-for="TestId" />
            <input type="hidden" asp-for="TestTitle" />
            <input type="hidden" asp-for="TestDescription" />
            <input type="hidden" asp-for="DurationInMinutes" />

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
                    <div class="flex items-start mb-4">
                        <span class="inline-flex items-center justify-center h-8 w-8 rounded-full bg-primary text-white font-bold text-sm mr-4 flex-shrink-0">
                            @(i + 1)
                        </span>
                        <div class="flex-1">
                            <p class="text-lg font-medium text-slate-900">@Model.Questions[i].QuestionText</p>
                            <span class="text-sm text-slate-500">@Model.Questions[i].Points puan</span>
                        </div>
                    </div>
                    
                    <input type="hidden" asp-for="Questions[i].QuestionId" />
                    <input type="hidden" asp-for="Questions[i].QuestionText" />
                    <input type="hidden" asp-for="Questions[i].Points" />
                    
                    <div class="space-y-3 ml-12">
                        @for (int j = 0; j < Model.Questions[i].Options.Count; j++)
                        {
                            <div class="flex items-center p-3 border border-slate-200 rounded-lg hover:border-primary hover:bg-slate-50 transition-colors cursor-pointer">
                                <input class="h-5 w-5 text-primary focus:ring-primary border-slate-300" type="radio" 
                                       asp-for="Questions[i].Options[j].IsSelected" 
                                       value="true"
                                       name="Questions[@i].SelectedOption"
                                       id="q@(i)_opt@(j)" />
                                <label class="ml-3 text-slate-700 cursor-pointer flex-1" for="q@(i)_opt@(j)">
                                    @Model.Questions[i].Options[j].OptionText
                                </label>
                                <input type="hidden" asp-for="Questions[i].Options[j].OptionId" />
                                <input type="hidden" asp-for="Questions[i].Options[j].OptionText" />
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="flex space-x-4 mt-6">
                <button type="submit" class="flex-1 px-6 py-4 border border-transparent rounded-xl shadow-sm text-lg font-medium text-white bg-primary hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors">
                    Sınavı Gönder
                </button>
                <a asp-action="Dashboard" class="flex-1 px-6 py-4 border border-slate-300 rounded-xl shadow-sm text-lg font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors text-center">
                    İptal
                </a>
            </div>
        </form>
    </div>

    <script>
        let timeLeft = @Model.DurationInMinutes * 60;
        const timerElement = document.getElementById('timer');
        const form = document.getElementById('testForm');
        
        function updateTimer() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timerElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                timerElement.textContent = '0:00';
                form.submit();
            }
            
            timeLeft--;
        }
        
        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer();
        
        document.querySelectorAll('[name^="Questions"][name$="SelectedOption"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const questionName = this.name.replace('SelectedOption', 'Options[');
                document.querySelectorAll(`[name^="${questionName}"][type="hidden"]`).forEach(hidden => {
                    hidden.value = 'false';
                });
                const index = this.id.match(/opt(\d+)/)[1];
                const hiddenInput = document.querySelector(`[name="${questionName}${index}].IsSelected"][type="hidden"]`);
                if (hiddenInput) {
                    hiddenInput.value = 'true';
                }
            });
        });
    </script>
</body>
</html>
