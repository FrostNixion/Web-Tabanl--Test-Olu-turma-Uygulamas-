@model List<AvailableTestViewModel>

@{
    ViewData["Title"] = "Öğrenci Paneli";
}

<div class="space-y-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-ink">Sınavlar</h1>
            <p class="text-ink-500 mt-1">Mevcut sınavları görüntüleyin ve katılın.</p>
        </div>
        <a asp-action="History" class="btn btn-ghost py-2.5">Geçmişim</a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-primary-light text-primary">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.Count">0</p>
                    <p class="stat-label">Toplam Sınav</p>
                </div>
            </div>
        </div>
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-[#ecfdf5] text-[#059669]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.Count(t => t.IsCompleted)">0</p>
                    <p class="stat-label">Tamamlanan</p>
                </div>
            </div>
        </div>
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-[#fffbeb] text-[#b45309]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.Count(t => !t.IsCompleted)">0</p>
                    <p class="stat-label">Bekleyen</p>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-12 text-center">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-light text-primary mb-4">
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-ink mb-2">Mevcut sınav yok</h3>
            <p class="text-ink-500">Şu anda katılabileceğiniz sınav bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-stagger>
            @foreach (var item in Model)
            {
                var totalPoints = item.Test.Questions.Sum(q => q.Points);
                var percentage = item.Score.HasValue && totalPoints > 0 ? (item.Score.Value * 100.0 / totalPoints) : 0;
                var percentageInt = (int)percentage;

                <div class="card card-hover p-5">
                    <div class="flex items-start justify-between mb-4">
                        <h3 class="font-semibold text-ink text-lg leading-tight flex-1 mr-2">@item.Test.Title</h3>
                        <span class="badge @(item.IsCompleted ? "badge-accent" : "badge-warning") shrink-0">
                            @(item.IsCompleted ? "Tamamlandı" : "Bekliyor")
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(item.Test.Description))
                    {
                        <p class="text-sm text-ink-500 mb-4 line-clamp-2">@item.Test.Description</p>
                    }

                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="bg-[var(--bg)] rounded-lg p-3">
                            <p class="text-xs text-ink-500 mb-1">Süre</p>
                            <p class="font-semibold text-ink">@item.Test.DurationInMinutes dk</p>
                        </div>
                        <div class="bg-[var(--bg)] rounded-lg p-3">
                            <p class="text-xs text-ink-500 mb-1">Soru</p>
                            <p class="font-semibold text-ink">@item.Test.Questions.Count adet</p>
                        </div>
                    </div>

                    @if (item.IsCompleted && item.Score.HasValue)
                    {
                        <div class="mb-4">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm text-ink-500">Puan</span>
                                <span class="font-semibold text-ink">@item.Score/@totalPoints</span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill @(percentageInt >= 70 ? "is-accent" : percentageInt >= 50 ? "" : "is-danger")" style="width: @percentageInt%"></div>
                            </div>
                        </div>
                    }

                    @if (item.IsCompleted)
                    {
                        <a asp-action="ViewResult" asp-route-id="@item.Test.Id" class="btn btn-soft w-full py-2 text-sm">Sonucu Gör</a>
                    }
                    else
                    {
                        <a asp-action="TakeTest" asp-route-id="@item.Test.Id" class="btn btn-primary w-full py-2.5 text-sm">Sınava Başla</a>
                    }
                </div>
            }
        </div>
    }
</div>
