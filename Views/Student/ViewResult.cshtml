@model TestResultViewModel

@{
    ViewData["Title"] = "Sınav Sonucu";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="text-center">
        <h1 class="text-2xl font-bold text-ink mb-1">Sınav Sonucu</h1>
        <p class="text-ink-500">@Model.TestTitle · @Model.TakenAt.ToString("dd MMM yyyy, HH:mm")</p>
    </div>

    @{
        var percentage = Model.TotalPoints > 0 ? (Model.Score * 100.0 / Model.TotalPoints) : 0;
        var percentageInt = (int)percentage;
        var emoji = percentageInt >= 70 ? "🎉" : percentageInt >= 50 ? "👍" : "💪";
        var message = percentageInt >= 70 ? "Mükemmel bir performans!" : percentageInt >= 50 ? "İyi bir performans!" : "Daha fazla çalışman gerekiyor.";
    }

    <div class="card p-8 text-center">
        <div class="text-6xl mb-4">@emoji</div>
        <p class="text-4xl font-bold text-ink mb-2">@percentageInt%</p>
        <p class="text-ink-500 mb-6">@Model.Score / @Model.TotalPoints puan</p>

        <div class="progress-track mb-6">
            <div class="progress-fill @(percentageInt >= 70 ? "is-accent" : percentageInt >= 50 ? "" : "is-danger")" style="width: @percentageInt%"></div>
        </div>

        <p class="text-ink-700 font-medium">@message</p>
    </div>

    <div class="flex gap-3">
        <a asp-action="Dashboard" class="btn btn-ghost flex-1 py-3">Panelime Dön</a>
        <a asp-action="History" class="btn btn-soft flex-1 py-3">Geçmişim</a>
    </div>
</div>
