@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="space-y-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-ink">Admin Paneli</h1>
            <p class="text-ink-500 mt-1">Sistem yönetimi ve kullanıcı yönetimi</p>
        </div>
        <a asp-action="Users" class="btn btn-primary py-2.5">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            Kullanıcılar
        </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-primary-light text-primary">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.TotalUsers">0</p>
                    <p class="stat-label">Toplam Kullanıcı</p>
                </div>
            </div>
        </div>
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-[#ecfdf5] text-[#059669]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.TotalTeachers">0</p>
                    <p class="stat-label">Öğretmen</p>
                </div>
            </div>
        </div>
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-[#fffbeb] text-[#b45309]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.TotalStudents">0</p>
                    <p class="stat-label">Öğrenci</p>
                </div>
            </div>
        </div>
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-[#f0fdf4] text-[#16a34a]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.TotalTests">0</p>
                    <p class="stat-label">Toplam Sınav</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Users -->
    @if (Model.RecentUsers.Any())
    {
        <div class="card p-6">
            <h2 class="text-xl font-bold text-ink mb-4">Son Kayıt Olan Kullanıcılar</h2>
            <div class="space-y-3">
                @foreach (var user in Model.RecentUsers)
                {
                    <div class="flex items-center gap-3 p-3 bg-[var(--bg)] rounded-lg">
                        <div class="h-10 w-10 rounded-full bg-primary-light text-primary flex items-center justify-center font-semibold text-sm">
                            @(user.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </div>
                        <div class="flex-1">
                            <p class="font-medium text-ink">@user.Name @user.Surname</p>
                            <p class="text-xs text-ink-500">@user.Email</p>
                        </div>
                        <span class="badge badge-soft text-xs">@user.Role</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- All Tests -->
    @if (Model.AllTests.Any())
    {
        <div class="card p-6">
            <h2 class="text-xl font-bold text-ink mb-4">Tüm Sınavlar</h2>
            <div class="space-y-3">
                @foreach (var test in Model.AllTests)
                {
                    <div class="flex items-center gap-3 p-3 bg-[var(--bg)] rounded-lg">
                        <div class="flex-1">
                            <p class="font-medium text-ink">@test.Title</p>
                            <p class="text-xs text-ink-500">@test.Questions.Count soru • @test.DurationInMinutes dakika</p>
                        </div>
                        <span class="badge badge-soft text-xs">@test.TestResults.Count katılım</span>
                        <a asp-action="TestResults" asp-route-id="@test.Id" class="btn btn-soft py-2 text-sm">Sonuçlar</a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Student Success Rates -->
    @if (Model.StudentSuccessRates.Any())
    {
        <div class="card p-6">
            <h2 class="text-xl font-bold text-ink mb-4">Öğrenci Başarı Oranları</h2>
            <div class="space-y-3">
                @foreach (var item in Model.StudentSuccessRates)
                {
                    <div class="flex items-center gap-3 p-3 bg-[var(--bg)] rounded-lg">
                        <div class="h-10 w-10 rounded-full bg-primary-light text-primary flex items-center justify-center font-semibold text-sm">
                            @(item.Student.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </div>
                        <div class="flex-1">
                            <p class="font-medium text-ink">@item.Student.Name @item.Student.Surname</p>
                            <p class="text-xs text-ink-500">@item.TotalTestsTaken sınav çözüldü</p>
                        </div>
                        <div class="text-right">
                            <p class="font-semibold text-ink">@item.AverageScore.ToString("F1")%</p>
                            <p class="text-xs text-ink-500">Ortalama</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
