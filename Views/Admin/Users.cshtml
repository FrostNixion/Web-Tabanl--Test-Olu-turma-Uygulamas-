@model List<UserWithRoleViewModel>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-ink">Kullanıcı Yönetimi</h1>
            <p class="text-ink-500 mt-1">Tüm kullanıcıları görüntüleyin ve yönetin</p>
        </div>
        <a asp-action="CreateUser" class="btn btn-primary py-2.5">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Kullanıcı Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-12 text-center">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-light text-primary mb-4">
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-ink mb-2">Henüz kullanıcı yok</h3>
            <p class="text-ink-500 mb-6">Başlamak için ilk kullanıcıyı oluşturun.</p>
            <a asp-action="CreateUser" class="btn btn-primary py-2.5">Kullanıcı Ekle</a>
        </div>
    }
    else
    {
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-[var(--border)]">
                            <th class="text-left px-5 py-3 text-xs font-semibold text-ink-500 uppercase">Kullanıcı</th>
                            <th class="text-left px-5 py-3 text-xs font-semibold text-ink-500 uppercase">E-posta</th>
                            <th class="text-left px-5 py-3 text-xs font-semibold text-ink-500 uppercase">Rol</th>
                            <th class="text-right px-5 py-3 text-xs font-semibold text-ink-500 uppercase">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-b border-[var(--border)] hover:bg-[var(--bg)]">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 rounded-full bg-primary-light text-primary flex items-center justify-center font-semibold text-sm">
                                            @(item.User.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                        </div>
                                        <div>
                                            <p class="font-medium text-ink">@item.User.Name @item.User.Surname</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4 text-sm text-ink-500">@item.User.Email</td>
                                <td class="px-5 py-4">
                                    @foreach (var role in item.Roles)
                                    {
                                        <span class="badge badge-@(role == "Admin" ? "danger" : role == "Teacher" ? "primary" : "accent")">@role</span>
                                    }
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <a asp-action="DeleteUser" asp-route-id="@item.User.Id" class="btn btn-danger py-2 px-3 text-sm" onclick="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?');">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
