@model CreateUserViewModel

@{
    ViewData["Title"] = "Kullanıcı Ekle";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-ink">Kullanıcı Ekle</h1>
            <p class="text-ink-500 mt-1">Yeni kullanıcı oluşturun</p>
        </div>
        <a asp-action="Users" class="btn btn-ghost py-2.5">İptal</a>
    </div>

    <div class="card p-6">
        <form asp-action="CreateUser" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-sm text-[var(--danger)] bg-[#fef2f2] border border-[#fecaca] rounded-[10px] px-4 py-3 mb-4 empty:hidden"></div>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-ink mb-2">Ad</label>
                    <input asp-for="Name" class="w-full px-4 py-2 border border-[var(--border)] rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required />
                    <span asp-validation-for="Name" class="text-sm text-[var(--danger)]"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink mb-2">Soyad</label>
                    <input asp-for="Surname" class="w-full px-4 py-2 border border-[var(--border)] rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required />
                    <span asp-validation-for="Surname" class="text-sm text-[var(--danger)]"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink mb-2">E-posta</label>
                    <input asp-for="Email" type="email" class="w-full px-4 py-2 border border-[var(--border)] rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required />
                    <span asp-validation-for="Email" class="text-sm text-[var(--danger)]"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink mb-2">Şifre</label>
                    <input asp-for="Password" type="password" class="w-full px-4 py-2 border border-[var(--border)] rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required />
                    <span asp-validation-for="Password" class="text-sm text-[var(--danger)]"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink mb-2">Rol</label>
                    <select asp-for="Role" class="w-full px-4 py-2 border border-[var(--border)] rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="Student">Öğrenci</option>
                        <option value="Teacher">Öğretmen</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <span asp-validation-for="Role" class="text-sm text-[var(--danger)]"></span>
                </div>

                <div class="flex gap-3 pt-4">
                    <button type="submit" class="btn btn-primary flex-1 py-2.5">Kullanıcı Ekle</button>
                    <a asp-action="Users" class="btn btn-ghost flex-1 py-2.5">İptal</a>
                </div>
            </div>
        </form>
    </div>
</div>
