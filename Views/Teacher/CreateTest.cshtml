@model CreateTestViewModel

@{
    ViewData["Title"] = "Sınav Oluştur";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-ink">Yeni Sınav Oluştur</h1>
            <p class="text-ink-500 mt-1">Çoktan seçmeli sorularla sınav hazırlayın.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-ghost py-2.5">İptal</a>
    </div>

    <form method="post" id="testForm">
        <div asp-validation-summary="All" class="text-sm text-[var(--danger)] bg-[#fef2f2] border border-[#fecaca] rounded-[10px] px-4 py-3 empty:hidden"></div>

        <div class="card p-6">
            <h2 class="text-lg font-semibold text-ink mb-4">Sınav Bilgileri</h2>
            <div class="space-y-4">
                <div>
                    <label asp-for="Title" class="label">Sınav Başlığı</label>
                    <input asp-for="Title" class="input" placeholder="Örn: Matematik Sınavı" />
                    <span asp-validation-for="Title" class="text-[var(--danger)] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Description" class="label">Açıklama</label>
                    <textarea asp-for="Description" class="input" rows="3" placeholder="Sınav hakkında kısa bilgi"></textarea>
                    <span asp-validation-for="Description" class="text-[var(--danger)] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="DurationInMinutes" class="label">Süre (Dakika)</label>
                    <input asp-for="DurationInMinutes" class="input" type="number" min="1" max="180" placeholder="Örn: 30" />
                    <span asp-validation-for="DurationInMinutes" class="text-[var(--danger)] text-xs mt-1 block"></span>
                </div>
            </div>
        </div>

        <div id="questionsContainer">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <div class="card p-6 question-card" data-question-index="@i">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-semibold text-ink">Soru @(i + 1)</h3>
                        @if (i > 0)
                        {
                            <button type="button" class="text-[var(--danger)] text-sm font-medium hover:underline remove-question">Sil</button>
                        }
                    </div>

                    <input type="hidden" asp-for="Questions[i].Id" />

                    <div class="space-y-4">
                        <div>
                            <label asp-for="Questions[i].QuestionText" class="label">Soru Metni</label>
                            <textarea asp-for="Questions[i].QuestionText" class="input" rows="2" placeholder="Sorunuzu buraya yazın"></textarea>
                            <span asp-validation-for="Questions[i].QuestionText" class="text-[var(--danger)] text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Questions[i].Points" class="label">Puan</label>
                            <input asp-for="Questions[i].Points" class="input" type="number" min="1" max="100" value="1" />
                            <span asp-validation-for="Questions[i].Points" class="text-[var(--danger)] text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <h4 class="text-sm font-semibold text-ink-700 mb-3">Seçenekler (doğru cevabı işaretleyin)</h4>
                            <div class="options-container space-y-3">
                                @for (int j = 0; j < Model.Questions[i].Options.Count; j++)
                                {
                                    <div class="flex items-center gap-3">
                                        <input class="h-4 w-4 text-primary focus:ring-primary border-[var(--border)]" type="radio"
                                               name="Questions[@i].CorrectOption" value="@j"
                                               @(Model.Questions[i].Options[j].IsCorrect ? "checked" : "") />
                                        <input asp-for="Questions[i].Options[j].OptionText" class="input flex-1" placeholder="Seçenek @(j + 1)" />
                                        <input type="hidden" asp-for="Questions[i].Options[j].Id" />
                                        <input type="hidden" asp-for="Questions[i].Options[j].IsCorrect" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button type="button" id="addQuestionBtn" class="btn btn-ghost w-full py-3 border-2 border-dashed border-[var(--border)] text-ink-500 hover:border-primary hover:text-primary">
            <svg class="h-5 w-5 mx-auto mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Soru Ekle
        </button>

        <div class="flex gap-3">
            <button type="submit" class="btn btn-primary flex-1 py-3">Sınav Oluştur</button>
            <a asp-action="Dashboard" class="btn btn-ghost flex-1 py-3">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        let questionIndex = @Model.Questions.Count;

        document.getElementById('addQuestionBtn').addEventListener('click', function() {
            const container = document.getElementById('questionsContainer');
            const questionHtml = `
                <div class="card p-6 question-card" data-question-index="${questionIndex}">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-semibold text-ink">Soru ${questionIndex + 1}</h3>
                        <button type="button" class="text-[var(--danger)] text-sm font-medium hover:underline remove-question">Sil</button>
                    </div>
                    <input type="hidden" name="Questions[${questionIndex}].Id" value="0" />
                    <div class="space-y-4">
                        <div>
                            <label class="label">Soru Metni</label>
                            <textarea name="Questions[${questionIndex}].QuestionText" class="input" rows="2" placeholder="Sorunuzu buraya yazın"></textarea>
                        </div>
                        <div>
                            <label class="label">Puan</label>
                            <input name="Questions[${questionIndex}].Points" class="input" type="number" min="1" max="100" value="1" />
                        </div>
                        <div>
                            <h4 class="text-sm font-semibold text-ink-700 mb-3">Seçenekler (doğru cevabı işaretleyin)</h4>
                            <div class="options-container space-y-3">
                                ${[0, 1, 2, 3].map(j => `
                                    <div class="flex items-center gap-3">
                                        <input class="h-4 w-4 text-primary focus:ring-primary border-[var(--border)]" type="radio" name="Questions[${questionIndex}].CorrectOption" value="${j}" />
                                        <input name="Questions[${questionIndex}].Options[${j}].OptionText" class="input flex-1" placeholder="Seçenek ${j + 1}" />
                                        <input type="hidden" name="Questions[${questionIndex}].Options[${j}].Id" value="0" />
                                        <input type="hidden" name="Questions[${questionIndex}].Options[${j}].IsCorrect" value="false" />
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', questionHtml);
            questionIndex++;
        });

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-question')) {
                const card = e.target.closest('.question-card');
                card.remove();
                updateQuestionIndices();
            }
        });

        function updateQuestionIndices() {
            const cards = document.querySelectorAll('.question-card');
            cards.forEach((card, index) => {
                card.setAttribute('data-question-index', index);
                card.querySelector('.flex.justify-between h3').textContent = `Soru ${index + 1}`;
                card.querySelectorAll('[name]').forEach(input => {
                    const name = input.name;
                    const newName = name.replace(/Questions\[\d+\]/, `Questions[${index}]`);
                    input.name = newName;
                });
            });
        }

        document.addEventListener('change', function(e) {
            if (e.target.type === 'radio' && e.target.name.includes('CorrectOption')) {
                const questionIndex = e.target.name.match(/Questions\[(\d+)\]/)[1];
                const optionIndex = e.target.value;
                const container = e.target.closest('.question-card');
                const isCorrectInputs = container.querySelectorAll('input[name$=".IsCorrect"][type="hidden"]');
                isCorrectInputs.forEach((input, idx) => {
                    input.value = (idx == optionIndex).toString();
                });
            }
        });
    </script>
}
