@model CreateTestViewModel

@{
    ViewData["Title"] = "Create Test";
}

<div class="row">
    <div class="col-12">
        <h2>Create New Test</h2>
        <hr />
    </div>
</div>

<form method="post" id="testForm">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Test Details</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="DurationInMinutes" class="form-label"></label>
                <input asp-for="DurationInMinutes" class="form-control" type="number" min="1" max="180" />
                <span asp-validation-for="DurationInMinutes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div id="questionsContainer">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            <div class="card mb-4 question-card" data-question-index="@i">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Question @(i + 1)</h5>
                    @if (i > 0)
                    {
                        <button type="button" class="btn btn-sm btn-danger remove-question">Remove</button>
                    }
                </div>
                <div class="card-body">
                    <input type="hidden" asp-for="Questions[i].Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Questions[i].QuestionText" class="form-label"></label>
                        <textarea asp-for="Questions[i].QuestionText" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Questions[i].QuestionText" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Questions[i].Points" class="form-label"></label>
                        <input asp-for="Questions[i].Points" class="form-control" type="number" min="1" max="100" />
                        <span asp-validation-for="Questions[i].Points" class="text-danger"></span>
                    </div>
                    
                    <h6>Options (select the correct answer)</h6>
                    <div class="options-container">
                        @for (int j = 0; j < Model.Questions[i].Options.Count; j++)
                        {
                            <div class="row mb-2 option-row">
                                <div class="col-1">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" 
                                               name="Questions[@i].CorrectOption" value="@j" 
                                               @(Model.Questions[i].Options[j].IsCorrect ? "checked" : "") />
                                    </div>
                                </div>
                                <div class="col-10">
                                    <input asp-for="Questions[i].Options[j].OptionText" class="form-control" placeholder="Option text" />
                                    <input type="hidden" asp-for="Questions[i].Options[j].Id" />
                                    <input type="hidden" asp-for="Questions[i].Options[j].IsCorrect" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <button type="button" id="addQuestionBtn" class="btn btn-secondary mb-3">Add Question</button>
    
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Create Test</button>
        <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let questionIndex = @Model.Questions.Count;
        
        document.getElementById('addQuestionBtn').addEventListener('click', function() {
            const container = document.getElementById('questionsContainer');
            const questionHtml = `
                <div class="card mb-4 question-card" data-question-index="${questionIndex}">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Question ${questionIndex + 1}</h5>
                        <button type="button" class="btn btn-sm btn-danger remove-question">Remove</button>
                    </div>
                    <div class="card-body">
                        <input type="hidden" name="Questions[${questionIndex}].Id" value="0" />
                        
                        <div class="mb-3">
                            <label class="form-label">Question Text</label>
                            <textarea name="Questions[${questionIndex}].QuestionText" class="form-control" rows="2"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Points</label>
                            <input name="Questions[${questionIndex}].Points" class="form-control" type="number" min="1" max="100" value="1" />
                        </div>
                        
                        <h6>Options (select the correct answer)</h6>
                        <div class="options-container">
                            ${[0, 1, 2, 3].map(j => `
                                <div class="row mb-2 option-row">
                                    <div class="col-1">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="Questions[${questionIndex}].CorrectOption" value="${j}" />
                                        </div>
                                    </div>
                                    <div class="col-10">
                                        <input name="Questions[${questionIndex}].Options[${j}].OptionText" class="form-control" placeholder="Option text" />
                                        <input type="hidden" name="Questions[${questionIndex}].Options[${j}].Id" value="0" />
                                        <input type="hidden" name="Questions[${questionIndex}].Options[${j}].IsCorrect" value="false" />
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', questionHtml);
            questionIndex++;
        });
        
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-question')) {
                const card = e.target.closest('.question-card');
                card.remove();
                updateQuestionIndices();
            }
        });
        
        function updateQuestionIndices() {
            const cards = document.querySelectorAll('.question-card');
            cards.forEach((card, index) => {
                card.setAttribute('data-question-index', index);
                card.querySelector('.card-header h5').textContent = `Question ${index + 1}`;
                
                // Update all input names
                card.querySelectorAll('[name]').forEach(input => {
                    const name = input.name;
                    const newName = name.replace(/Questions\[\d+\]/, `Questions[${index}]`);
                    input.name = newName;
                });
            });
        }
        
        // Handle radio button clicks to update IsCorrect hidden fields
        document.addEventListener('change', function(e) {
            if (e.target.type === 'radio' && e.target.name.includes('CorrectOption')) {
                const questionIndex = e.target.name.match(/Questions\[(\d+)\]/)[1];
                const optionIndex = e.target.value;
                
                const container = e.target.closest('.question-card');
                const isCorrectInputs = container.querySelectorAll('input[name$=".IsCorrect"][type="hidden"]');
                isCorrectInputs.forEach((input, idx) => {
                    input.value = (idx == optionIndex).toString();
                });
            }
        });
    </script>
}
