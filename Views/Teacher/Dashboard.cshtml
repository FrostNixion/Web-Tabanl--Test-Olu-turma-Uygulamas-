@model List<Test>

@{
    ViewData["Title"] = "Öğretmen Paneli";
}

<div class="space-y-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-ink">Sınavlarım</h1>
            <p class="text-ink-500 mt-1">Oluşturduğunuz sınavları yönetin ve performansı takip edin.</p>
        </div>
        <div class="flex gap-3">
            <a asp-action="Students" class="btn btn-soft py-2.5">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                Öğrenciler
            </a>
            <a asp-action="CreateTest" class="btn btn-primary py-2.5">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                Sınav Oluştur
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-primary-light text-primary">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.Count">0</p>
                    <p class="stat-label">Toplam Sınav</p>
                </div>
            </div>
        </div>
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-[#ecfdf5] text-[#059669]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.Sum(t => t.Questions.Count)">0</p>
                    <p class="stat-label">Toplam Soru</p>
                </div>
            </div>
        </div>
        <div class="stat">
            <div class="flex items-center gap-4">
                <div class="stat-icon bg-[#fffbeb] text-[#b45309]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                </div>
                <div>
                    <p class="stat-value" data-count="@Model.Sum(t => t.TestResults.Count)">0</p>
                    <p class="stat-label">Toplam Katılım</p>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-12 text-center">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-light text-primary mb-4">
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-ink mb-2">Henüz sınav oluşturulmadı</h3>
            <p class="text-ink-500 mb-6">Başlamak için ilk sınavınızı oluşturun.</p>
            <a asp-action="CreateTest" class="btn btn-primary py-2.5">Sınav Oluştur</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-stagger>
            @foreach (var test in Model)
            {
                <div class="card card-hover p-5">
                    <div class="flex items-start justify-between mb-4">
                        <h3 class="font-semibold text-ink text-lg leading-tight flex-1 mr-2">@test.Title</h3>
                        <span class="badge badge-primary shrink-0">@test.Questions.Count soru</span>
                    </div>

                    @if (!string.IsNullOrEmpty(test.Description))
                    {
                        <p class="text-sm text-ink-500 mb-4 line-clamp-2">@test.Description</p>
                    }

                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="bg-[var(--bg)] rounded-lg p-3">
                            <p class="text-xs text-ink-500 mb-1">Süre</p>
                            <p class="font-semibold text-ink">@test.DurationInMinutes dk</p>
                        </div>
                        <div class="bg-[var(--bg)] rounded-lg p-3">
                            <p class="text-xs text-ink-500 mb-1">Katılım</p>
                            <p class="font-semibold text-ink">@test.TestResults.Count kişi</p>
                        </div>
                    </div>

                    @if (test.TestResults.Any())
                    {
                        <div class="mb-4">
                            <p class="text-xs text-ink-500 mb-2">Katılan Öğrenciler:</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var result in test.TestResults)
                                {
                                    <span class="badge badge-soft text-xs">
                                        @(result.Student?.Name ?? "Bilinmeyen") @(result.Student?.Surname ?? "")
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <p class="text-xs text-ink-300 mb-4">@test.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>

                    <div class="flex gap-2">
                        <a asp-action="TestResults" asp-route-id="@test.Id" class="btn btn-soft flex-1 py-2 text-sm">Sonuçlar</a>
                        <a asp-action="DeleteTest" asp-route-id="@test.Id" class="btn btn-danger py-2 px-3 text-sm" onclick="return confirm('Bu sınavı silmek istediğinizden emin misiniz?');">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
