@model List<Test>

@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Tests</h2>
    <a asp-action="CreateTest" class="btn btn-primary">Create New Test</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <h4>No tests created yet</h4>
        <p>Create your first test to get started!</p>
        <a asp-action="CreateTest" class="btn btn-primary">Create Test</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var test in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">@test.Title</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><strong>Description:</strong> @test.Description</p>
                        <p class="mb-2"><strong>Duration:</strong> @test.DurationInMinutes minutes</p>
                        <p class="mb-2"><strong>Questions:</strong> @test.Questions.Count</p>
                        <p class="mb-0"><strong>Created:</strong> @test.CreatedAt.ToString("MM/dd/yyyy HH:mm")</p>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group w-100">
                            <a asp-action="TestResults" asp-route-id="@test.Id" class="btn btn-info">View Results</a>
                            <a asp-action="DeleteTest" asp-route-id="@test.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this test?');">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
