@model List<Test>

@{
    ViewData["Title"] = "Öğretmen Paneli";
}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">Sınavlarım</h1>
    <p class="text-slate-600 mt-1">Oluşturduğunuz sınavları yönetin</p>
</div>

<div class="flex justify-between items-center mb-6">
    <div></div>
    <a asp-action="CreateTest" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors">
        <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Yeni Sınav Oluştur
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="bg-white rounded-xl shadow-sm p-12 text-center">
        <svg class="mx-auto h-16 w-16 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="mt-4 text-lg font-medium text-slate-900">Henüz sınav oluşturulmadı</h3>
        <p class="mt-2 text-slate-600">Başlamak için ilk sınavınızı oluşturun.</p>
        <div class="mt-6">
            <a asp-action="CreateTest" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors">
                <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Sınav Oluştur
            </a>
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var test in Model)
        {
            <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-200">
                <div class="p-6">
                    <div class="flex items-start justify-between">
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-slate-900 mb-2">@test.Title</h3>
                            @if (!string.IsNullOrEmpty(test.Description))
                            {
                                <p class="text-sm text-slate-600 mb-4">@test.Description</p>
                            }
                        </div>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-primary">
                            @test.Questions.Count Soru
                        </span>
                    </div>
                    
                    <div class="space-y-2 text-sm text-slate-600">
                        <div class="flex items-center">
                            <svg class="h-4 w-4 mr-2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            @test.DurationInMinutes dakika
                        </div>
                        <div class="flex items-center">
                            <svg class="h-4 w-4 mr-2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            @test.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
                
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 rounded-b-xl">
                    <div class="flex space-x-3">
                        <a asp-action="TestResults" asp-route-id="@test.Id" class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors">
                            Sonuçları Gör
                        </a>
                        <a asp-action="DeleteTest" asp-route-id="@test.Id" class="inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" onclick="return confirm('Bu sınavı silmek istediğinizden emin misiniz?');">
                            Sil
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
