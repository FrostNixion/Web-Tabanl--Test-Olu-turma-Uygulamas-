@model List<TestResult>

@{
    ViewData["Title"] = "Test Results";
}

<div class="mb-4">
    <h2>Test Results: @ViewBag.TestTitle</h2>
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <h4>No results yet</h4>
        <p>No students have taken this test yet.</p>
    </div>
}
else
{
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Score</th>
                        <th>Date Taken</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.Student?.Name @result.Student?.Surname (@result.Student?.Email)</td>
                            <td>@result.Score</td>
                            <td>@result.TakenAt.ToString("MM/dd/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
