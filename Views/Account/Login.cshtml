@model LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sınav Yönetim Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/app.css" />
    <script>
        tailwind.config = {
            theme: { extend: {
                colors: {
                    primary: { DEFAULT: '#4f46e5', hover: '#4338ca', light: '#eef2ff' },
                    ink: { DEFAULT: '#0f172a', 500: '#64748b', 700: '#334155' },
                    accent: { DEFAULT: '#10b981' },
                },
                fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
            } }
        }
    </script>
</head>
<body class="min-h-screen font-sans antialiased">
    <div class="min-h-screen grid lg:grid-cols-2">
        <!-- Left: Brand hero (hidden on mobile) -->
        <div class="auth-hero hidden lg:flex flex-col justify-between p-12 text-white">
            <div class="relative z-10 flex items-center gap-3">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/15 backdrop-blur">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </span>
                <span class="text-xl font-bold">Sınav Yönetim Sistemi</span>
            </div>

            <div class="relative z-10 max-w-md">
                <h1 class="text-4xl font-extrabold leading-tight mb-4">Sınavlarını dijital ortamda yönet.</h1>
                <p class="text-white/80 text-lg leading-relaxed">Öğretmenler için kolay sınav oluşturma, öğrenciler için anında değerlendirme ve sonuç takibi.</p>

                <div class="mt-10 space-y-4">
                    <div class="flex items-center gap-3">
                        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-white/15">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                        </span>
                        <span class="text-white/90">Otomatik puanlama ve raporlama</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-white/15">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3" /><circle cx="12" cy="12" r="9" /></svg>
                        </span>
                        <span class="text-white/90">Süreli ve güvenli sınav ortamı</span>
                    </div>
                </div>
            </div>

            <p class="relative z-10 text-white/60 text-sm">© 2026 Bitirme Projesi</p>
        </div>

        <!-- Right: Login form -->
        <div class="flex items-center justify-center p-6 sm:p-12 bg-[var(--bg)]">
            <div class="w-full max-w-sm animate-in">
                <!-- Mobile brand -->
                <div class="lg:hidden flex items-center gap-2.5 mb-8">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </span>
                    <span class="text-lg font-bold text-ink">Sınav Sistemi</span>
                </div>

                <h2 class="text-2xl font-bold text-ink mb-1">Tekrar hoş geldin</h2>
                <p class="text-ink-500 mb-8">Hesabına giriş yaparak devam et.</p>

                <form method="post" class="space-y-5">
                    <div asp-validation-summary="All" class="text-sm text-[var(--danger)] bg-[#fef2f2] border border-[#fecaca] rounded-[10px] px-4 py-3 empty:hidden"></div>

                    <div>
                        <label asp-for="Email" class="label">E-posta</label>
                        <input asp-for="Email" class="input" placeholder="ornek@eposta.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-[var(--danger)] text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="Password" class="label mb-0">Şifre</label>
                        </div>
                        <div class="relative">
                            <input asp-for="Password" type="password" id="pwd" class="input pr-11" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" id="togglePwd" aria-label="Şifreyi göster" class="absolute inset-y-0 right-0 flex items-center pr-3 text-ink-500 hover:text-ink">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-[var(--danger)] text-xs mt-1 block"></span>
                    </div>

                    <label class="flex items-center gap-2.5 cursor-pointer select-none">
                        <input asp-for="RememberMe" class="h-4 w-4 rounded border-[var(--border)] text-primary focus:ring-primary" />
                        <span class="text-sm text-ink-700">Beni hatırla</span>
                    </label>

                    <button type="submit" class="btn btn-primary w-full py-3 text-base">Giriş Yap</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('togglePwd')?.addEventListener('click', function () {
            const pwd = document.getElementById('pwd');
            pwd.type = pwd.type === 'password' ? 'text' : 'password';
        });
    </script>
</body>
</html>
