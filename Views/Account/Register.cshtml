@model RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sınav Yönetim Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/app.css" />
    <script>
        tailwind.config = {
            theme: { extend: {
                colors: {
                    primary: { DEFAULT: '#4f46e5', hover: '#4338ca', light: '#eef2ff' },
                    ink: { DEFAULT: '#0f172a', 500: '#64748b', 700: '#334155' },
                    accent: { DEFAULT: '#10b981' },
                },
                fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
            } }
        }
    </script>
</head>
<body class="min-h-screen font-sans antialiased">
    <div class="min-h-screen grid lg:grid-cols-2">
        <!-- Left: Brand hero -->
        <div class="auth-hero hidden lg:flex flex-col justify-between p-12 text-white">
            <div class="relative z-10 flex items-center gap-3">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/15 backdrop-blur">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </span>
                <span class="text-xl font-bold">Sınav Yönetim Sistemi</span>
            </div>

            <div class="relative z-10 max-w-md">
                <h1 class="text-4xl font-extrabold leading-tight mb-4">Birkaç adımda aramıza katıl.</h1>
                <p class="text-white/80 text-lg leading-relaxed">İster öğretmen ister öğrenci ol; sınav oluştur, çöz ve sonuçlarını anında gör.</p>
            </div>

            <p class="relative z-10 text-white/60 text-sm">© 2026 Bitirme Projesi</p>
        </div>

        <!-- Right: Register form -->
        <div class="flex items-center justify-center p-6 sm:p-12 bg-[var(--bg)]">
            <div class="w-full max-w-sm animate-in">
                <div class="lg:hidden flex items-center gap-2.5 mb-8">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </span>
                    <span class="text-lg font-bold text-ink">Sınav Sistemi</span>
                </div>

                <h2 class="text-2xl font-bold text-ink mb-1">Hesap oluştur</h2>
                <p class="text-ink-500 mb-8">Bilgilerini girerek hemen başla.</p>

                <form method="post" class="space-y-4">
                    <div asp-validation-summary="All" class="text-sm text-[var(--danger)] bg-[#fef2f2] border border-[#fecaca] rounded-[10px] px-4 py-3 empty:hidden"></div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label asp-for="Name" class="label">Ad</label>
                            <input asp-for="Name" class="input" placeholder="Ad" />
                            <span asp-validation-for="Name" class="text-[var(--danger)] text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Surname" class="label">Soyad</label>
                            <input asp-for="Surname" class="input" placeholder="Soyad" />
                            <span asp-validation-for="Surname" class="text-[var(--danger)] text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Email" class="label">E-posta</label>
                        <input asp-for="Email" class="input" placeholder="ornek@eposta.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-[var(--danger)] text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="label">Şifre</label>
                        <input asp-for="Password" type="password" class="input" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-[var(--danger)] text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="label">Şifre Tekrar</label>
                        <input asp-for="ConfirmPassword" type="password" class="input" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-[var(--danger)] text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Role" class="label">Rol</label>
                        <select asp-for="Role" class="input">
                            <option value="">Rol seçin</option>
                            <option value="Teacher">Öğretmen</option>
                            <option value="Student">Öğrenci</option>
                        </select>
                        <span asp-validation-for="Role" class="text-[var(--danger)] text-xs mt-1 block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-full py-3 text-base mt-2">Kayıt Ol</button>
                </form>

                <p class="text-center text-sm text-ink-500 mt-8">
                    Zaten hesabın var mı?
                    <a asp-action="Login" class="font-semibold text-primary hover:text-primary-hover">Giriş yap</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
