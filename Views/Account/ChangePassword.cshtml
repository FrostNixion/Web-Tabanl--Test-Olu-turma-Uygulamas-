@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="max-w-md mx-auto">
    <h1 class="text-2xl font-bold text-ink mb-1">Şifre Değiştir</h1>
    <p class="text-ink-500 mb-8">Hesabınızın şifresini güncelleyin.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-[#ecfdf5] border border-[#a7f3d0] text-[#065f46] rounded-[10px] px-4 py-3 mb-6" data-auto-dismiss>
            @TempData["SuccessMessage"]
        </div>
    }

    <form method="post" class="space-y-5">
        <div asp-validation-summary="All" class="text-sm text-[var(--danger)] bg-[#fef2f2] border border-[#fecaca] rounded-[10px] px-4 py-3 empty:hidden"></div>

        <div>
            <label asp-for="CurrentPassword" class="label">Mevcut Şifre</label>
            <input asp-for="CurrentPassword" type="password" class="input" placeholder="••••••••" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-[var(--danger)] text-xs mt-1 block"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="label">Yeni Şifre</label>
            <input asp-for="NewPassword" type="password" class="input" placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-[var(--danger)] text-xs mt-1 block"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="label">Yeni Şifre Tekrar</label>
            <input asp-for="ConfirmPassword" type="password" class="input" placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-[var(--danger)] text-xs mt-1 block"></span>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="btn btn-primary flex-1 py-3">Şifreyi Değiştir</button>
            <a href="@(User.IsInRole("Teacher") ? "/Teacher/Dashboard" : "/Student/Dashboard")" class="btn btn-ghost flex-1 py-3">İptal</a>
        </div>
    </form>
</div>
